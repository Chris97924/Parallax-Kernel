# Copy to gmail-smtp-relay.env (chmod 600) and fill in.
# Real values are secret — never commit. The repo .gitignore covers *.env.

# Gmail account that signs in to send. Use a dedicated alerting mailbox if
# you can; otherwise the on-call's own Gmail address is fine. Must have
# 2FA enabled and an App Password issued for "Mail" (see:
# https://myaccount.google.com/apppasswords).
GMAIL_SMTP_USER=

# 16-character App Password (NOT the account password). Generate at the
# URL above. Treat as a credential — leak = full mailbox compromise.
GMAIL_SMTP_APP_PASSWORD=

# Comma-separated list of recipients. Same syntax as RFC 5322 "To:".
#   e.g. oncall@example.com
#   e.g. oncall@example.com, escalation@example.com
GMAIL_SMTP_TO=

# Optional overrides
RELAY_HOST=127.0.0.1
RELAY_PORT=9096
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
# Per-send connect+command timeout (seconds). Alertmanager will retry on 500.
GMAIL_SMTP_TIMEOUT=10
