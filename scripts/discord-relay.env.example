# Copy to discord-relay.env (chmod 600) and fill in.
# Real values are secret — never commit.

# Discord channel webhook URL. Get from:
#   Discord channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
# Format: https://discord.com/api/webhooks/<channel_webhook_id>/<token>
DISCORD_WEBHOOK=

# Optional overrides
RELAY_HOST=127.0.0.1
RELAY_PORT=9095
