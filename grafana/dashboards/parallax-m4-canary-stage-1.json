          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 16, "x": 16, "y": 8},
      "id": 6,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (outcome) (rate(parallax_canary_events_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Canary event throughput by outcome (1m rate)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
