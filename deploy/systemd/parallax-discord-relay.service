[Unit]
Description=Parallax Alertmanager -> Discord relay
After=network.target

[Service]
Type=simple
EnvironmentFile=/home/chris/parallax-kernel/scripts/discord-relay.env
ExecStart=/usr/bin/python3 /home/chris/parallax-kernel/scripts/discord-relay.py
Restart=on-failure
RestartSec=3s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
