# Parallax runtime configuration
# Copy this file to `.env` and edit values for your local setup.
# All three are optional; defaults resolve under the project root.

# Path to the SQLite database file.
PARALLAX_DB_PATH=./db/parallax.db

# Path to the Obsidian vault root (markdown storage).
PARALLAX_VAULT_PATH=./vault

# Path to the canonical schema (DDL) file.
PARALLAX_SCHEMA_PATH=./schema.sql

# Apex M5 audit-row SQLite path (per docs/m5-prep/audit-db-path-config.md).
# Required for M4 GATE 3 canary推進. If unset, defaults per OS family:
#   Windows dev    : E:\Parallax\data\audit.db
#   Linux ZenBook  : /home/chris/parallax-kernel/db/audit.db
# Path MUST be absolute, parent directory MUST exist and be writable.
PARALLAX_AUDIT_DB_PATH=
