  "description": "Parallax M4 — Canary Stage 1 Observability. Five triggers (T1-T5) per US-009.1 §3.3 / AC 1.9-1.18. Thresholds pinned to parallax/canary/triggers.py constants: T1/T2 = 0.5%, T3 = 100ms p99, T4 = 0 events, T5 gate = 50 hits/5min.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "T1 — canary error_rate over 5-min sliding window. Threshold: 0.5% (parallax/canary/triggers.py::T1_THRESHOLD). Green < 0.25%, yellow 0.25-0.5%, red >= 0.5% (auto-rollback).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "max": 0.01,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.0025},
              {"color": "red", "value": 0.005}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "(sum(rate(parallax_canary_event_errors_total[5m])) / (sum(rate(parallax_canary_events_total[5m])) > 0))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "T1 — Canary error rate (5m)",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "T2 — canary discrepancy_rate over 3-min sliding window. Threshold: 0.5% (parallax/canary/triggers.py::T2_THRESHOLD). Green < 0.25%, yellow 0.25-0.5%, red >= 0.5% (auto-rollback).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "max": 0.01,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.0025},
              {"color": "red", "value": 0.005}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "(sum(rate(parallax_canary_discrepancy_total[3m])) / (sum(rate(parallax_canary_events_total[3m])) > 0))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "T2 — Canary discrepancy rate (3m)",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "T3 — canary request p99 latency over 5-min sliding window. Threshold: 100ms (parallax/canary/triggers.py::T3_THRESHOLD_MS). Green < 50ms, yellow 50-100ms, red >= 100ms (auto-rollback).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "max": 200,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 100}
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.99, sum by (le) (rate(parallax_canary_request_duration_ms_bucket[5m])))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "T3 — Canary p99 latency (5m)",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "T4 — canary data-loss events (rolling 1h cumulative). Threshold: > 0 (parallax/canary/triggers.py::T4_THRESHOLD). Hard rollback condition with no hysteresis per AC-1.13.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "increase(parallax_canary_data_loss_events_total[1h])",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "T4 — Canary data loss events (1h cumulative)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "T5 — canary event hits over 5-min window. Gate (NOT trigger): when < 50 (parallax/canary/triggers.py::T5_MIN_HITS), T1-T4 verdicts downgrade to insufficient_data. Do NOT promote stage on green-from-T1-T4 while T5 is active.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "yellow", "value": null},
              {"color": "green", "value": 50}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8},
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(parallax_canary_events_total[5m]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "T5 gate — Canary hits (5m, gate-active when < 50)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Canary event throughput by outcome. Useful context for interpreting T1-T3 rate trends.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
